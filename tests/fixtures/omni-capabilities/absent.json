        "capabilities": {
          "text.chat": "unknown",
          "image.generate": "unknown",
          "image.edit": "unknown",
          "image.segment": "unknown",
          "video.generate": "unknown",
          "video.matting": "unknown",
          "video.motion_capture": "unknown",
          "audio.speech": "unknown",
          "audio.music": "unknown",
          "audio.score": "unknown",
          "video.first_frame": "unknown",
          "video.edit": "unknown",
          "image.cutout": "unknown",
          "audio.separate": "unknown"
        },
        "unresolved": []
      }
    },
    {
      "id": "no-stages-field",
      "note": "The endpoint answers but the body carries no `stages` field.",
      "payload": {
        "object": "omni.capabilities"
      },
      "expected": {
        "endpoint": "absent",
        "stages": {},
        "capabilities": {
          "text.chat": "unknown",
