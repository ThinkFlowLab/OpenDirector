{
  "name": "@opendirector/desktop",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "pack": "electron-builder --dir",
    "pack:windows": "electron-builder --win nsis --x64",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "org.opendirector.desktop",
    "productName": "OpenDirector",
    "asar": true,
    "directories": {
      "output": "build"
    },
    "files": [
      "src/**",
      "scripts/smoke-window.mjs",
      "scripts/large-video.mjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime"
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": "dir"
    },
    "win": {
      "target": "dir"
    },
    "nsis": {
      "artifactName": "OpenDirector-v${version}-win-${arch}-unsigned.${ext}",
      "deleteAppDataOnUninstall": false,
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": "dir",
      "category": "AudioVideo"
    },
    "icon": "../../src/assets/open_director_logo.png"
  },
  "allowScripts": {
    "electron@45.3.3": true,
    "electron-winstaller@5.4.0": true
  },
  "description": "OpenDirector desktop shell and private Python Host",
  "author": "OpenDirector contributors"
}
