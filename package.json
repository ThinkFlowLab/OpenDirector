{
  "name": "opendirector",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.ts",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:browser-locale": "node scripts/check-browser-locale.mjs",
    "check:browser-manifest": "node scripts/check-browser-manifest.mjs",
    "test:browser": "node scripts/run-browser-suite.mjs"
  },
  "dependencies": {
    "@lobehub/icons-static-svg": "1.102.0",
    "@mediabunny/aac-encoder": "1.62.1",
    "@xyflow/react": "12.12.0",
    "mediabunny": "1.62.1",
    "opencode-ai": "1.19.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "streamdown": "2.5.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.2.0",
    "prettier": "3.8.3",
    "typescript": "5.8.3",
    "vite": "6.4.4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "opencode-ai@1.19.5": true
  }
}
